CAPITAL_MAX_WORKING=
CAPITAL_MIN_RESERVE=
TARGET_EQUITY=
MIN_PROFIT_PER_TRADE=0.01
MAX_TRADE_ALLOCATION=0.25
MAX_DAILY_LOSS=0.10
MAX_TRADE_SIZE=
MAX_POSITION=
MAX_DRAWDOWN=0.10
MAX_SLIPPAGE_BPS=25
MAX_GAS_USD=0.25
MAX_QUOTE_AGE_MS=1000
MAX_UNHEDGED_TIME_MS=3000
MAX_OPEN_TRADES=1
PROFIT_SAFETY_RESERVE=0.01
TRADING_SIGNER_REF=
