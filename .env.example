# PostgreSQL (authoritative persistence; no Supabase)
DATABASE_URL=postgresql://abn:change-me@localhost:5432/abn

# Redis (ephemeral coordination, locks, queues, hot market state)
REDIS_URL=redis://localhost:6379

# Authentication / session signing (Auth.js)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_ISSUER=https://appleid.apple.com

# Runtime
NODE_ENV=development
TRADING_MODE=DRY_RUN
EXECUTION_ENABLED=false

# Web credential encryption (32-byte key encoded as base64; server-side only)
# Generate outside the repository. Never expose this through NEXT_PUBLIC_* variables.
CREDENTIAL_ENCRYPTION_KEY=

# DRY_RUN engine endpoint (optional; frontend preflight remains fail-closed when absent)
DRY_RUN_ENGINE_URL=

# RPC
ALCHEMY_API_KEY=
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_IDS=

# Hummingbot API — production live execution broker
# Hummingbot API v1 uses HTTP Basic authentication; keep these in Vault/HSM/secure secrets.
HUMMINGBOT_URL=
HUMMINGBOT_USERNAME=
HUMMINGBOT_PASSWORD=
HUMMINGBOT_API_KEY=
HUMMINGBOT_EXECUTION_ENABLED=false
HUMMINGBOT_TIMEOUT_MS=5000
HUMMINGBOT_ACCOUNT=master_account
HUMMINGBOT_BUY_CONNECTOR=
HUMMINGBOT_SELL_CONNECTOR=

# CEX credentials: inject through Vault/HSM/secure secret manager in production
MEXC_API_KEY=
MEXC_API_SECRET=
GATE_API_KEY=
GATE_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSWORD=
BYBIT_API_KEY=
BYBIT_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSWORD=
BITFINEX_API_KEY=
BITFINEX_API_SECRET=
LBANK_API_KEY=
LBANK_API_SECRET=

# CAPITAL MODEL
# Capital is NOT a configured starting amount. The worker discovers and verifies
# actual available capital from the configured funded signer / venue inventory.
# A trade is considered only when an executable opportunity exists AND verified
# available capital can fund that opportunity while preserving the reserve/risk gates.
CAPITAL_MODEL=FUNDED_SIGNER
CAPITAL_STARTING_USD=0
CAPITAL_MIN_RESERVE_USD=0
TARGET_EQUITY_USD=0
MIN_PROFIT_PER_TRADE_USD=0
MAX_TRADE_ALLOCATION=0.85
MAX_DAILY_LOSS_USD=0
MAX_TRADE_SIZE_USD=0
MAX_POSITION_USD=0
MAX_DRAWDOWN_USD=0
MAX_SLIPPAGE_BPS=25
MAX_GAS_USD=0
MAX_QUOTE_AGE_MS=1000
MAX_UNHEDGED_TIME_MS=3000
MAX_OPEN_TRADES=1
PROFIT_SAFETY_RESERVE_USD=0

# Signer boundary. Never put the raw private key here.
# The worker resolves this reference through the protected signer provider.
TRADING_SIGNER_REF=
SIGNER_PROVIDER_URL=
SIGNER_PROVIDER_TOKEN=
SIGNER_PROVIDER_MODULE=
SIGNER_BALANCE_NETWORK=ethereum
CAPITAL_ASSET=USDC
CAPITAL_ASSET_USD_RATE=1
